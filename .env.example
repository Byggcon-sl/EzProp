# Kopier til .env og tilpass. .env skal aldri sjekkes inn.

# Database for utvikling
DATABASE_URL=postgres://ezprop:ezprop@localhost:5432/ezprop
# Egen database for automatiske tester (tømmes ved hver testkjøring)
TEST_DATABASE_URL=postgres://ezprop:ezprop@localhost:5432/ezprop_test

# Innlogging (Better Auth). Lag en lang tilfeldig streng, f.eks. `openssl rand -base64 32`
BETTER_AUTH_SECRET=bytt-meg-til-en-lang-tilfeldig-streng-pa-minst-32-tegn
BETTER_AUTH_URL=http://localhost:3000

# Første admin som opprettes av `pnpm db:seed` (ansatt i organisasjonen Byggcon)
SEED_ADMIN_EMAIL=admin@byggcon.no
SEED_ADMIN_NAME="Byggcon Admin"

# Utviklings-postkasse: viser e-poster på /dev/epost i stedet for å sende dem.
# Virker bare når BETTER_AUTH_URL er localhost. Skal aldri være på i produksjon.
# Uten DEV_MAILBOX (og uten Microsoft 365 under) skrives engangskoden til første admin
# (SEED_ADMIN_EMAIL) i serverloggen. Andre kan ikke logge inn før Microsoft 365 er koblet til.
DEV_MAILBOX=1

# E-post via Microsoft 365 (Microsoft Graph). Brukes når DEV_MAILBOX ikke er 1 og alle fire
# er fylt ut (kobles til i fase 0b). Til da: koden til første admin i serverloggen.
# Alle fire må fylles ut sammen. Verdiene legges bare her eller i serverens miljøinnstillinger,
# aldri i chat eller kode.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MAIL_FROM=noreply@byggcon.no

# Prøve uten nett (fase 1): synktjenesten PowerSync. ./start.sh starter den i Docker.
# Adressen iPaden og nettleseren kobler til synktjenesten på.
POWERSYNC_URL=http://localhost:8080
# Delt nøkkel for innloggingen mot synktjenesten (minst 32 tegn). VERDIEN UNDER ER IKKE HEMMELIG:
# den er bare for Macen og nektes når BETTER_AUTH_URL ikke er localhost. I Azure legges en egen,
# tilfeldig verdi inn som hemmelighet (`openssl rand -base64 48`), aldri her.
POWERSYNC_JWT_SECRET=utvikling-ikke-hemmelig-synknokkel-bare-for-mac-0123456789
# Prøve uten nett (fase 1), kandidat 2: synktjenesten ElectricSQL. ./start.sh starter den i Docker.
# Adressen serveren (ikke iPaden) henter shapes fra. iPaden leser bare via /api/prove/synk/shape.
ELECTRIC_URL=http://localhost:3010
# Delt nøkkel mellom appen og Electric (minst 32 tegn). VERDIEN UNDER ER IKKE HEMMELIG:
# den er bare for Macen og nektes når BETTER_AUTH_URL ikke er localhost. I Azure legges en egen,
# tilfeldig verdi inn som hemmelighet (`openssl rand -base64 48`), aldri her.
ELECTRIC_SECRET=utvikling-ikke-hemmelig-electricnokkel-bare-for-mac-0123456789
# Mappen der bildefilene fra testskjemaet lagres på serveren (ligger i .gitignore).
TRIAL_UPLOAD_DIR=var/uploads/trial
# Største bildefil i byte. Uten verdi gjelder 25 MB (26214400).
# TRIAL_PHOTO_MAX_BYTES=

# Versjonen helsesjekken (/api/helse) viser, f.eks. git-commit. Settes av hostingen ved
# utrulling; uten den brukes versjonen i package.json. Trengs ikke lokalt.
# APP_VERSION=
