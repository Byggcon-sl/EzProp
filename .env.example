# Kopier til .env og tilpass. .env skal aldri sjekkes inn.

# Database for utvikling
DATABASE_URL=postgres://ezprop:ezprop@localhost:5432/ezprop
# Egen database for automatiske tester (tømmes ved hver testkjøring)
TEST_DATABASE_URL=postgres://ezprop:ezprop@localhost:5432/ezprop_test

# Innlogging (Better Auth). Lag en lang tilfeldig streng, f.eks. `openssl rand -base64 32`
BETTER_AUTH_SECRET=bytt-meg-til-en-lang-tilfeldig-streng-pa-minst-32-tegn
BETTER_AUTH_URL=http://localhost:3000

# Første admin som opprettes av `pnpm db:seed` (ansatt i organisasjonen Byggcon)
SEED_ADMIN_EMAIL=admin@byggcon.no
SEED_ADMIN_NAME="Byggcon Admin"

# Utviklings-postkasse: viser e-poster på /dev/epost i stedet for å sende dem.
# Virker bare når BETTER_AUTH_URL er localhost. Skal aldri være på i produksjon.
# Uten DEV_MAILBOX (og uten Microsoft 365 under) skrives engangskoden til første admin
# (SEED_ADMIN_EMAIL) i serverloggen. Andre kan ikke logge inn før de fire under er fylt ut.
DEV_MAILBOX=1

# E-post via Microsoft 365 (Microsoft Graph). Brukes når DEV_MAILBOX ikke er 1 og alle fire
# er fylt ut. De fire settes sammen: alle eller ingen. Er en MS_GRAPH-verdi fylt ut og en av
# de andre mangler, stopper appen ved start.
# Sendingen går fra én postboks (MAIL_FROM) med klientlegitimasjon, som i Optiplan.
# MS_GRAPH_CLIENT_SECRET er NAVNET tilkoblingslaget leser gjennom readSecret
# (src/core/integrations/secrets.ts). readSecret er eneste vei til hemmeligheter og byttes ut
# når nøkkelboksen kommer. Verdiene legges bare her eller i serverens miljøinnstillinger,
# aldri i chat, kode eller repoet. La dem stå tomme her.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MAIL_FROM=noreply@byggcon.no

# KI-leverandøren (ADR 0006). Tom = KI av. Verdien legges bare i .env eller på serveren, aldri i repoet.
ANTHROPIC_API_KEY=

# Mappen der bildefilene fra testskjemaet lagres på serveren (ligger i .gitignore).
TRIAL_UPLOAD_DIR=var/uploads/trial
# Største bildefil i byte. Uten verdi gjelder 25 MB (26214400).
# TRIAL_PHOTO_MAX_BYTES=

# Fillagring for bilder og dokumenter (felles filtjeneste). Standard er en lokal mappe
# (ligger i .gitignore). FILE_STORAGE_DRIVER er local eller azure; andre verdier gir feil.
# Dette er standardverdiene; linjene trengs bare når de skal være noe annet.
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_DIR=var/files
# Azure Blob Storage (bare kode foreløpig, slås på av Ståle senere). Lagringskontoen skal ligge i
# Sweden Central (EU/EØS), containeren skal være privat (ingen offentlig tilgang), og Microsofts
# databehandleravtale for Azure gjelder. Verdiene legges bare i serverens miljøinnstillinger eller
# Key Vault, aldri her, i chat eller i kode. Begge må fylles ut når FILE_STORAGE_DRIVER=azure.
FILE_STORAGE_AZURE_CONNECTION_STRING=
FILE_STORAGE_AZURE_CONTAINER=

# Versjonen helsesjekken (/api/helse) viser, f.eks. git-commit. Settes av hostingen ved
# utrulling; uten den brukes versjonen i package.json. Trengs ikke lokalt.
# APP_VERSION=
